# Market Dashboard Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: FRED API (Federal Reserve Economic Data)
# Get free key at: https://fred.stlouisfed.org/docs/api/api_key.html
# =============================================================================
FRED_API_KEY=your_fred_api_key_here

# =============================================================================
# RECOMMENDED: Nasdaq Data Link (for COT positioning data)
# Get free key at: https://data.nasdaq.com (sign up, go to Account Settings)
# Without this, COT data uses slow CFTC downloads
# Alias: the COT collector also reads QUANDL_API_KEY as a fallback, but
# QUANDL_API_KEY is a legacy alias and is not part of the primary inventory.
# =============================================================================
NASDAQ_DATA_LINK_KEY=your_nasdaq_data_link_key_here

# =============================================================================
# FINRA API key (optional)
# Register at: https://www.finra.org/finra-data
# The dark-pool collector propagates this key into the Authorization header
# (see issue #49), but live FINRA authentication has not been verified.
# =============================================================================
FINRA_API_KEY=
